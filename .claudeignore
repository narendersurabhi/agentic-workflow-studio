uv.lock
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# Generated runtime artifacts
artifacts/
output/
workspace/

# Evaluation results
.deepeval/
eval/

# Claude internals
.claude/

# Binary outputs
**/*.docx
**/*.pdf
**/*.png
**/*.jpg
**/*.jpeg
**/*.ico
**/*.woff
**/*.woff2

# Logs
**/*.log

